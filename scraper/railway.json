{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "**/*.py",
      "requirements.txt",
      "runtime.txt",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python cricket_scraper.py",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
